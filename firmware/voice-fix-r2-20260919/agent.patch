diff --git a/src/voice/audio_playback.c b/src/voice/audio_playback.c
index 6a2089c..7526847 100644
--- a/src/voice/audio_playback.c
+++ b/src/voice/audio_playback.c
@@ -26,6 +26,8 @@
 #include <string.h>
 #include <syslog.h>
 #include <unistd.h>
+#include <stdatomic.h>
+#include <time.h>
 
 static const char* TAG = "audio_pb";
 
@@ -37,9 +39,20 @@ struct audio_playback {
     void* player;
     size_t total_written;
     int bytes_per_frame;
-    volatile int stopped;
+    atomic_int stopped;
+    atomic_int completed;
+    atomic_int error;
+    unsigned int sample_rate;
 };
 
+static void qiji_playback_event(void *cookie, int event, int result, const char *extra)
+{
+    (void)extra;
+    audio_playback_t *pb = cookie;
+    if (result < 0) atomic_store(&pb->error, result);
+    if (event == MEDIA_EVENT_COMPLETED) atomic_store(&pb->completed, 1);
+}
+
 audio_playback_t* audio_playback_open(const char* dev_path,
     unsigned int sample_rate, unsigned int channels,
     unsigned int bits_per_sample)
@@ -86,6 +99,15 @@ audio_playback_t* audio_playback_open(const char* dev_path,
         return NULL;
     }
 
+    atomic_init(&pb->stopped, 0);
+    atomic_init(&pb->completed, 0);
+    atomic_init(&pb->error, 0);
+    pb->sample_rate = sample_rate;
+    if (media_player_set_event_callback(player, pb, qiji_playback_event) < 0) {
+        media_player_close(player, 0);
+        free(pb);
+        return NULL;
+    }
     pb->player = player;
     pb->bytes_per_frame = (bits_per_sample / 8) * channels;
     s_active_player = player;
@@ -105,12 +127,21 @@ int audio_playback_write(audio_playback_t* pb, const void* buf, size_t len)
         return -ECANCELED;
     }
 
-    ssize_t n = media_player_write_data(pb->player, buf, len);
-    if (n > 0) {
-        pb->total_written += (size_t)n;
+    if (atomic_load(&pb->error)) return atomic_load(&pb->error);
+    size_t written = 0;
+    while (written < len) {
+        if (atomic_load(&pb->stopped)) return -ECANCELED;
+        ssize_t n = media_player_write_data(pb->player,
+            (const unsigned char *)buf + written, len - written);
+        if (n <= 0) {
+            int error = n < 0 ? (int)n : -EIO;
+            atomic_store(&pb->error, error);
+            return error;
+        }
+        written += n;
+        pb->total_written += n;
     }
-
-    return (int)n;
+    return (int)written;
 }
 
 void audio_playback_stop(audio_playback_t* pb)
@@ -140,3 +171,22 @@ void audio_playback_close(audio_playback_t* pb)
 
     free(pb);
 }
+
+/* EOF flushes decoder output; wait for audible completion, not network EOF. */
+int qiji_audio_playback_finish(audio_playback_t *pb)
+{
+    if (!pb || !pb->player) return -EINVAL;
+    media_player_close_socket(pb->player);
+    struct timespec start, now;
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    unsigned long limit = pb->total_written / (pb->sample_rate * pb->bytes_per_frame) + 10;
+    if (limit > 130) limit = 130;
+    for (;;) {
+        if (atomic_load(&pb->error)) return atomic_load(&pb->error);
+        if (atomic_load(&pb->stopped)) return -ECANCELED;
+        if (atomic_load(&pb->completed)) return 0;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        if (now.tv_sec - start.tv_sec >= (long)limit) return -ETIMEDOUT;
+        usleep(20000);
+    }
+}
