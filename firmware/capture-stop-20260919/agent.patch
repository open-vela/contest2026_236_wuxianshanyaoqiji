+int audio_playback_write(audio_playback_t *pb, const void *buf, size_t len)
+{
+    if (!pb || !pb->player || !buf || !len || len % 2) return -EINVAL;
+    const unsigned char *src = buf;
+    int16_t output[768];
+    size_t offset = 0;
+    while (offset < len) {
