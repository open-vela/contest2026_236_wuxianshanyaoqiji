+static int media_accept_socket(MediaIOPriv* priv)
+{
+    if (!priv)
+        return -EINVAL;
+
+    if (priv->socket > 0)
+        return 0;
+
+    if (priv->socket_fd <= 0)
+        return -ENOTCONN;
+
+#ifdef CONFIG_GEMINI_CHAT_MINIMAL
+    /* Qiji bounded PCM connection establishment. */
+    struct pollfd waitfd = { .fd = priv->socket_fd, .events = POLLIN };
+    int ready = poll(&waitfd, 1, 5000);
+    if (ready <= 0) return ready ? -errno : -ETIMEDOUT;
+#endif
+    priv->socket = accept4(priv->socket_fd, NULL, NULL, SOCK_CLOEXEC);
+    if (priv->socket < 0) {
+        priv->socket = 0;
+        return -errno;
+    }
+
+#ifdef CONFIG_GEMINI_CHAT_MINIMAL
+    struct timeval timeout = { .tv_sec = 0, .tv_usec = 250000 };
+    if (setsockopt(priv->socket, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) < 0) {
+        int saved = errno;
+        close(priv->socket);
+        priv->socket = 0;
+        return -saved;
+    }
+#endif
+    return 0;
+}
