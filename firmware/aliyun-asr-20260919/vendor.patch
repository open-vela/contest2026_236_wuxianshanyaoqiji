@@ -1052,6 +1053,19 @@ hal_dma_status_t hal_dma_stop(struct sunxi_dma_chan *chan)
     hal_writel(CHAN_STOP, DMA_ENABLE(chan->chan_count));
     hal_writel(CHAN_RESUME, DMA_PAUSE(chan->chan_count));
 
+    /* Disable and clear this channel's DMA IRQ before teardown so a
+     * hardware-latched completion interrupt cannot re-enter
+     * sunxi_dma_irq_handle() and dereference a desc/callback that
+     * sunxi_dma_free_ill() is about to free (start path re-enables it).
+     */
+    high = (chan->chan_count + START_CHAN_OFFSET >= HIGH_CHAN) ? 1 : 0;
+    __ccpsr = hal_spin_lock_irqsave(&dma_lock);
+    irq_val = hal_readl(DMA_IRQ_EN(high));
+    irq_val &= ~(SHIFT_IRQ_MASK(chan->irq_type, chan->chan_count));
+    hal_writel(irq_val, DMA_IRQ_EN(high));
+    hal_writel(SHIFT_IRQ_MASK(chan->irq_type, chan->chan_count), DMA_IRQ_STAT(high));
+    hal_spin_unlock_irqrestore(&dma_lock, __ccpsr);
+
     if (chan->cyclic)
     {
         chan->cyclic = false;
