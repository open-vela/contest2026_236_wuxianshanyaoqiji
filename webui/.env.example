# ═══════════════════════════════════════════════
# 豆包（火山引擎）API 凭证
# 复制此文件为 .env 并填入真实凭证
# 未配置时自动降级为 mock 模式（用于 UI 开发调试）
# ═══════════════════════════════════════════════

# 火山引擎语音 App ID（ASR + TTS 共用）
DOUBAO_APP_ID=

# 火山引擎语音 Access Token
DOUBAO_ACCESS_TOKEN=

# ASR 集群 ID（通用流式识别）
DOUBAO_ASR_CLUSTER=volcengine_streaming_common

# TTS 集群 ID
DOUBAO_TTS_CLUSTER=volcano_tts

# 方舟（Ark）LLM API Key
DOUBAO_ARK_API_KEY=

# ═══════════════════════════════════════════════
# 服务端口
# ═══════════════════════════════════════════════
PORT=3001
